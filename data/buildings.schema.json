{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/thailand-rental-map/buildings.schema.json",
  "title": "Thailand Rental Map building directory",
  "description": "Residential buildings along the Sukhumvit BTS corridor from Nana to Bearing, plus Ari and Silom–Sathorn. Names and coordinates come from OpenStreetMap under the Open Database License.",
  "type": "object",
  "additionalProperties": false,
  "required": ["area", "areas", "attribution", "retrieved_at", "buildings"],
  "properties": {
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "bbox"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "bbox": {
          "type": "object",
          "additionalProperties": false,
          "required": ["south", "west", "north", "east"],
          "properties": {
            "south": { "type": "number" },
            "west": { "type": "number" },
            "north": { "type": "number" },
            "east": { "type": "number" }
          }
        }
      }
    },
    "areas": {
      "type": "array",
      "items": { "type": "object" }
    },
    "attribution": { "type": "string" },
    "retrieved_at": { "type": "string" },
    "buildings": {
      "type": "array",
      "items": { "$ref": "#/$defs/building" }
    }
  },
  "$defs": {
    "building": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "name_en", "name_th", "aliases", "type", "lat", "lng", "areas", "named", "source", "osm_ref"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "name_en": { "type": ["string", "null"] },
        "name_th": { "type": ["string", "null"] },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "type": { "type": "string", "enum": ["condo", "apartment", "other"] },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "areas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "nana", "asok", "phrom-phong", "thong-lo", "ekamai", "phra-khanong",
              "on-nut", "bang-chak", "punnawithi", "udom-suk", "bang-na", "bearing",
              "ari", "silom-sathorn"
            ]
          }
        },
        "named": { "type": "boolean" },
        "source": { "type": "string", "minLength": 1 },
        "osm_ref": { "type": "string" },
        "address": {
          "type": "string",
          "minLength": 1,
          "description": "Street line from OSM addr:street, addr:housenumber, addr:place, or addr:full. Omitted when OpenStreetMap has no street address. Unnamed buildings already use that label as name."
        },
        "locality": {
          "type": "string",
          "minLength": 1,
          "description": "Subdistrict, district, city, province, and postcode from OSM addr tags, when those tags exist."
        },
        "photo_url": {
          "type": "string",
          "minLength": 1,
          "description": "Public building image from the OSM image tag or Wikimedia Commons. Omitted when OpenStreetMap has no image."
        }
      }
    }
  }
}
